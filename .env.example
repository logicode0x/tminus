# Local development defaults. Copy to .env and set your own public platform wallet.
# Use http://127.0.0.1:8899 for a local validator.
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
SOLANA_RPC_RPS=10
PLATFORM_WALLET=
ORIGIN=http://localhost:8787
PORT=8787
BRAND_NAME=T-minus
DATA_DIR=data
DATABASE_URL=

# Local metadata storage is for development; use arweave or bucket for real launches.
STORAGE=local
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=auto
TURBO_UPLOAD_URL=https://upload.ardrive.io

# Optional server signer: base58 secret key or JSON array. Never commit a filled .env.
STUDIO_WALLET_KEY=
STUDIO_LOOKUP_TABLE=
CRANKS=off
CRANK_INTERVAL_SEC=60
REFERRAL_PAYOUTS=off

# Review platform terms before enabling real launches.
PLATFORM_CURVE_SHARE_PCT=10
PLATFORM_POOL_CREATION_FEE_SOL=0
PLATFORM_GRADUATED_LIQUIDITY_PCT=10
PLATFORM_PLAIN_POOL_FEE_SOL=0.1
REFERRAL_SHARE_PCT=30

# Optional integrations: use credentials belonging to your own deployment.
JUPITER_API_KEY=
JUPITER_REFERRAL_ACCOUNT=
TRADE_FEE_BPS=50
COINGECKO_API_KEY=
ADMIN_TOKEN=
POSTHOG_KEY=
POSTHOG_HOST=https://eu.i.posthog.com
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=
